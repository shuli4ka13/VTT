    "effects": {
      "action_roll": {
        "label": "Бросок действия",
        "group": "Действия",
        "activation": "manual",
        "description": "Кости двойственности + черта против сложности, которую называет ведущий. Крит — одинаковые значения на костях: успех при любом итоге.",
        "params": [
          {
            "key": "trait",
            "label": "Черта",
            "kind": "choice",
            "from": "traits",
            "ask": {
              "by": "actor"
            }
          },
          {
            "key": "сложность",
            "label": "Сложность",
            "kind": "number",
            "ask": {
              "by": "gm",
              "min": 1,
              "max": 30
            }
          }
        ],
        "steps": [
          {
            "id": "бросок",
            "type": "threshold",
            "roll": {
              "die": {
                "constant": "duality"
              },
              "bonus": {
                "expr": "таблица(\"traits\", @trait, \"value\")"
              },
              "tags": [
                "действие",
                {
                  "param": "trait"
                }
              ]
            },
            "versus": {
              "expr": "@сложность"
            },
            "continueOn": "always"
          }
        ]
      },
      "hero_attack": {
        "label": "Атака героя",
        "group": "Атака",
        "activation": "manual",
        "description": "Кости двойственности + черта оружия против сложности противника. Попал — кости урона по числу мастерства плюс прибавка оружия; на крите сверху максимум костей урона.",
        "params": [
          {
            "key": "trait",
            "label": "Черта оружия",
            "kind": "choice",
            "from": "traits"
          },
          {
            "key": "damage_die",
            "label": "Кость урона",
            "kind": "dice"
          },
          {
            "key": "die_size",
            "label": "Граней на кости урона",
            "kind": "number"
          },
          {
            "key": "damage_bonus",
            "label": "Прибавка к урону",
            "kind": "number"
          }
        ],
        "steps": [
          {
            "id": "бросок",
            "type": "threshold",
            "roll": {
              "die": {
                "constant": "duality"
              },
              "bonus": {
                "expr": "таблица(\"traits\", @trait, \"value\")"
              },
              "tags": [
                "атака"
              ]
            },
            "versus": {
              "expr": "@получатель.difficulty"
            },
            "continueOn": "always"
          },
          {
            "type": "compare",
            "value": {
              "expr": "любое(@бросок.success, @бросок.parts.надежда == @бросок.parts.страх) ? 1 : 0"
            },
            "versus": {
              "expr": "1"
            },
            "breakIf": "less",
            "note": "промах"
          },
          {
            "id": "урон",
            "type": "amount",
            "source": "item",
            "fixed": {
              "expr": "кинуть(@damage_die, @отправитель.proficiency) + @damage_bonus + (@бросок.parts.надежда == @бросок.parts.страх ? @отправитель.proficiency * @die_size : 0)"
            }
          },
          {
            "type": "emit",
            "event": "damage",
            "args": {
              "amount": {
                "expr": "@урон"
              }
            }
          }
        ]
      },
      "adversary_attack": {
        "label": "Атака противника",
        "group": "Атака",
        "activation": "manual",
        "description": "к20 + модификатор атаки против уклонения героя. Попал — урон, вписанный в приём.",
        "params": [
          {
            "key": "damage_dice",
            "label": "Кость урона",
            "kind": "dice"
          },
          {
            "key": "damage_bonus",
            "label": "Прибавка к урону",
            "kind": "number"
          }
        ],
        "steps": [
          {
            "id": "удар",
            "type": "threshold",
            "roll": {
              "die": {
                "constant": "adversary_die"
              },
              "bonus": {
                "expr": "@attack_mod"
              },
              "tags": [
                "атака"
              ]
            },
            "versus": {
              "expr": "@получатель.evasion"
            }
          },
          {
            "id": "урон",
            "type": "amount",
            "source": "item",
            "fixed": {
              "expr": "кинуть(@damage_dice) + @damage_bonus"
            }
          },
          {
            "type": "emit",
            "event": "damage",
            "args": {
              "amount": {
                "expr": "@урон"
              }
            }
          }
        ]
      },
      "damage": {
        "label": "Урон",
        "group": "Вызываемые",
        "description": "Урон сравнивается с порогами: ниже серьёзного — одна клетка хитов, от серьёзного — две, от тяжёлого — три. Если есть свободный бронеслот, он отмечается и снимает одну клетку; по книге это выбор игрока, в образце — всегда.",
        "params": [
          {
            "key": "amount",
            "label": "Сколько урона",
            "kind": "number",
            "role": "amount"
          }
        ],
        "steps": [
          {
            "type": "apply",
            "target": {
              "tag": "hp"
            },
            "direction": "add",
            "value": {
              "expr": "max(0, (@event.amount >= @severe ? 3 : (@event.amount >= @major ? 2 : (@event.amount >= 1 ? 1 : 0))) - (все(@armor_marked < @armor_score, (@event.amount >= @severe ? 3 : (@event.amount >= @major ? 2 : (@event.amount >= 1 ? 1 : 0))) >= 1) ? 1 : 0))"
            },
            "targetModifiers": false
          },
          {
            "type": "apply",
            "target": {
              "tag": "armor_marked"
            },
            "direction": "add",
            "value": {
              "expr": "1"
            },
            "targetModifiers": false,
            "when": {
              "expr": "все(@armor_marked < @armor_score, (@event.amount >= @severe ? 3 : (@event.amount >= @major ? 2 : (@event.amount >= 1 ? 1 : 0))) >= 1)"
            }
          }
        ]
      },
      "duality": {
        "label": "Двойственность",
        "group": "Правила",
        "activation": "passive",
        "duration": {
          "kind": "permanent"
        },
        "description": "После броска двойственности: больше выпало на Надежде — герой получает Надежду; на Страхе — ведущий получает Страх; одинаково — крит: Надежда и минус один Стресс.",
        "on": [
          {
            "on": "action_roll",
            "role": "sender",
            "if": {
              "expr": "@бросок.parts.надежда > @бросок.parts.страх"
            },
            "steps": [
              {
                "type": "apply",
                "target": {
                  "tag": "hope"
                },
                "direction": "add",
                "value": {
                  "expr": "1"
                },
                "targetModifiers": false
              }
            ]
          },
          {
            "on": "action_roll",
            "role": "sender",
            "if": {
              "expr": "@бросок.parts.страх > @бросок.parts.надежда"
            },
            "steps": [
              {
                "type": "apply",
                "target": {
                  "tag": "fear"
                },
                "direction": "add",
                "value": {
                  "expr": "1"
                },
                "targetModifiers": false
              }
            ]
          },
          {
            "on": "action_roll",
            "role": "sender",
            "if": {
              "expr": "@бросок.parts.надежда == @бросок.parts.страх"
            },
            "steps": [
              {
                "type": "apply",
                "target": {
                  "tag": "hope"
                },
                "direction": "add",
                "value": {
                  "expr": "1"
                },
                "targetModifiers": false
              },
              {
                "type": "apply",
                "target": {
                  "tag": "stress"
                },
                "direction": "subtract",
                "value": {
                  "expr": "1"
                },
                "targetModifiers": false,
                "when": {
                  "expr": "@stress >= 1"
                }
              }
            ]
          },
          {
            "on": "hero_attack",
            "role": "sender",
            "if": {
              "expr": "@бросок.parts.надежда > @бросок.parts.страх"
            },
            "steps": [
              {
                "type": "apply",
                "target": {
                  "tag": "hope"
                },
                "direction": "add",
                "value": {
                  "expr": "1"
                },
                "targetModifiers": false
              }
            ]
          },
          {
            "on": "hero_attack",
            "role": "sender",
            "if": {
              "expr": "@бросок.parts.страх > @бросок.parts.надежда"
            },
            "steps": [
              {
                "type": "apply",
                "target": {
                  "tag": "fear"
                },
                "direction": "add",
                "value": {
                  "expr": "1"
                },
                "targetModifiers": false
              }
            ]
          },
          {
            "on": "hero_attack",
            "role": "sender",
            "if": {
              "expr": "@бросок.parts.надежда == @бросок.parts.страх"
            },
            "steps": [
              {
                "type": "apply",
                "target": {
                  "tag": "hope"
                },
                "direction": "add",
                "value": {
                  "expr": "1"
                },
                "targetModifiers": false
              },
              {
                "type": "apply",
                "target": {
                  "tag": "stress"
                },
                "direction": "subtract",
                "value": {
                  "expr": "1"
                },
                "targetModifiers": false,
                "when": {
                  "expr": "@stress >= 1"
                }
              }
            ]
          }
        ]
      },
      "death_move": {
        "label": "Смертельный ход",
        "group": "Состояния",
        "activation": "passive",
        "duration": {
          "kind": "permanent"
        },
        "description": "Отмечен последний хит: игрок выбирает смертельный ход — «Сгореть во славе», «Избежать смерти» или «Рискнуть всем». Решает стол.",
        "modifiers": []
      },
      "last_hp": {
        "label": "Последний хит",
        "group": "Правила",
        "activation": "passive",
        "duration": {
          "kind": "permanent"
        },
        "params": [],
        "description": "Отмечен последний хит — «Смертельный ход».",
        "on": [
          {
            "on": "field:down",
            "steps": [
              {
                "type": "status",
                "mode": "apply",
                "effect": {
                  "const": "death_move"
                }
              }
            ]
          }
        ]
      },
      "long_rest": {
        "label": "Долгий отдых",
        "group": "Отдых",
        "activation": "manual",
        "description": "Все хиты, весь Стресс и все бронеслоты свободны. Остальное из списка дел на отдыхе решает стол.",
        "steps": [
          {
