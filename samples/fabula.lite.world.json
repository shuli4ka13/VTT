{
  "title": "Fabula Ultima",
  "system": {
    "id": "fabula-ultima",
    "name": "Fabula Ultima",
    "tables": {
      "лист": {
        "label": "Лист",
        "shape": "single",
        "owner": "sheet",
        "columns": [
          {
            "key": "ловкость",
            "label": "Ловкость",
            "kind": "number",
            "default": 8,
            "min": 6,
            "max": 12
          },
          {
            "key": "восприятие",
            "label": "Восприятие",
            "kind": "number",
            "default": 8,
            "min": 6,
            "max": 12
          },
          {
            "key": "сила",
            "label": "Сила",
            "kind": "number",
            "default": 8,
            "min": 6,
            "max": 12
          },
          {
            "key": "воля",
            "label": "Воля",
            "kind": "number",
            "default": 8,
            "min": 6,
            "max": 12
          },
          {
            "key": "защита",
            "label": "Защита",
            "kind": "number",
            "default": 10
          },
          {
            "key": "маг_защита",
            "label": "Магическая защита",
            "kind": "number",
            "default": 10
          },
          {
            "key": "оз_макс",
            "label": "Очки здоровья, максимум",
            "kind": "number",
            "default": 40,
            "min": 0
          },
          {
            "key": "оз",
            "label": "Очки здоровья",
            "kind": "number",
            "default": 40,
            "min": 0,
            "max": {
              "expr": "@оз_макс"
            }
          },
          {
            "key": "ом_макс",
            "label": "Очки маны, максимум",
            "kind": "number",
            "default": 40,
            "min": 0
          },
          {
            "key": "ом",
            "label": "Очки маны",
            "kind": "number",
            "default": 40,
            "min": 0,
            "max": {
              "expr": "@ом_макс"
            }
          }
        ]
      },
      "характеристики": {
        "label": "Характеристики",
        "key": "word",
        "columns": [
          {
            "key": "поле",
            "label": "Поле листа",
            "kind": "text"
          }
        ],
        "rows": [
          {
            "value": "ловкость",
            "label": "Ловкость",
            "cells": {
              "поле": "ловкость"
            }
          },
          {
            "value": "восприятие",
            "label": "Восприятие",
            "cells": {
              "поле": "восприятие"
            }
          },
          {
            "value": "сила",
            "label": "Сила",
            "cells": {
              "поле": "сила"
            }
          },
          {
            "value": "воля",
            "label": "Воля",
            "cells": {
              "поле": "воля"
            }
          }
        ]
      },
      "броски": {
        "label": "Броски",
        "key": "word",
        "columns": [],
        "rows": [
          {
            "value": "проверка",
            "label": "Проверка"
          }
        ]
      },
      "оружие": {
        "label": "Оружие",
        "shape": "book",
        "use": "item",
        "columns": [
          {
            "key": "первая",
            "label": "Первая характеристика",
            "kind": "choice",
            "from": "характеристики"
          },
          {
            "key": "вторая",
            "label": "Вторая характеристика",
            "kind": "choice",
            "from": "характеристики"
          },
          {
            "key": "точность",
            "label": "Прибавка к меткости",
            "kind": "number"
          },
          {
            "key": "урон",
            "label": "Урон сверх старшей кости",
            "kind": "number"
          }
        ],
        "bindings": [
          {
            "label": "Атаковать",
            "effect": "атака",
            "args": {
              "первая": {
                "expr": "@первая"
              },
              "вторая": {
                "expr": "@вторая"
              },
              "точность": {
                "expr": "@точность"
              },
              "урон": {
                "expr": "@урон"
              }
            }
          }
        ]
      },
      "расходник": {
        "label": "Расходник",
        "shape": "book",
        "use": "item",
        "columns": [
          {
            "key": "лечит",
            "label": "Сколько ОЗ возвращает",
            "kind": "number"
          }
        ],
        "bindings": [
          {
            "label": "Применить",
            "effect": "лечение",
            "args": {
              "сколько": {
                "expr": "@лечит"
              }
            }
          }
        ]
      },
      "действие": {
        "label": "Действие",
        "shape": "book",
        "use": "action",
        "columns": [],
        "bindings": []
      }
    },
    "constants": {
      "пара": {
        "label": "две кости характеристик",
        "kind": "die",
        "dice": [
          {
            "count": 1,
            "sides": 6,
            "name": "первая"
          },
          {
            "count": 1,
            "sides": 6,
            "name": "вторая"
          }
        ]
      }
    },
    "rolls": {
      "проверка": {
        "label": "Проверка",
        "die": "пара",
        "number": "sides",
        "pair": true,
        "success": {
          "expr": "(@roll.parts.первая == @roll.parts.вторая and @roll.parts.первая >= 6) or (not(@roll.parts.первая == 1 and @roll.parts.вторая == 1) and @rolled >= @threshold)"
        },
        "degrees": [
          {
            "label": "критический успех",
            "if": {
              "expr": "@roll.parts.первая == @roll.parts.вторая and @roll.parts.первая >= 6"
            }
          },
          {
            "label": "критический провал",
            "if": {
              "expr": "@roll.parts.первая == 1 and @roll.parts.вторая == 1"
            }
          }
        ],
        "fields": [
          {
            "table": "лист",
            "column": "ловкость"
          },
          {
            "table": "лист",
            "column": "восприятие"
          },
          {
            "table": "лист",
            "column": "сила"
          },
          {
            "table": "лист",
            "column": "воля"
          }
        ]
      }
    },
    "blocks": [
      {
        "name": "Характеристики",
        "parts": [
          {
            "table": "лист",
            "columns": [
              "ловкость",
              "восприятие",
              "сила",
              "воля"
            ]
          }
        ]
      },
      {
        "name": "Бой",
        "parts": [
          {
            "table": "лист",
            "columns": [
              "защита",
              "маг_защита",
              "оз",
              "оз_макс",
              "ом",
              "ом_макс"
            ],
            "views": {
              "оз": {
                "kind": "stepper"
              },
              "ом": {
                "kind": "stepper"
              }
            }
          }
        ]
      }
    ],
    "effects": {
      "проверка": {
        "label": "Проверка",
        "description": "Две кости двух характеристик, сумма против сложности: лёгкая 7, средняя 10, трудная 13. Дубль от шестёрок и выше — успех при любой сумме, две единицы — провал при любой.",
        "params": [
          {
            "kind": "sheet",
            "key": "действующий",
            "label": "Кто действует"
          },
          {
            "key": "первая",
            "label": "Первая характеристика",
            "kind": "choice",
            "from": "характеристики",
            "ask": {
              "by": "actor",
              "hint": "Грани первой кости — значение этой характеристики."
            }
          },
          {
            "key": "вторая",
            "label": "Вторая характеристика",
            "kind": "choice",
            "from": "характеристики",
            "ask": {
              "by": "actor",
              "hint": "Вторая кость. Чтобы бросить одну характеристику дважды, выберите её ещё раз."
            }
          },
          {
            "key": "сложность",
            "label": "Сложность",
            "kind": "number",
            "ask": {
              "by": "gm",
              "hint": "Лёгкая 7, средняя 10, трудная 13."
            }
          }
        ],
        "steps": [
          {
            "id": "бросок",
            "type": "roll",
            "field": {
              "expr": "@действующий.[@первая.поле]"
            },
            "second": {
              "expr": "@действующий.[@вторая.поле]"
            }
          },
          {
            "id": "проверка",
            "type": "check",
            "value": {
              "expr": "@бросок"
            },
            "versus": {
              "expr": "if(@бросок.parts.первая == @бросок.parts.вторая and @бросок.parts.первая >= 6, 0, if(@бросок.parts.первая == 1 and @бросок.parts.вторая == 1, 999, @сложность))"
            },
            "degrees": [
              {
                "label": "критический успех",
                "if": {
                  "expr": "@бросок.parts.первая == @бросок.parts.вторая and @бросок.parts.первая >= 6"
                }
              },
              {
                "label": "критический провал",
                "if": {
                  "expr": "@бросок.parts.первая == 1 and @бросок.parts.вторая == 1"
                }
              }
            ]
          }
        ]
      },
      "атака": {
        "label": "Атака",
        "description": "Проверка меткости: две кости характеристик оружия плюс его прибавка против Защиты цели. Попал — урон: старшая из двух костей плюс число оружия.",
        "params": [
          {
            "kind": "sheet",
            "key": "действующий",
            "label": "Кто действует"
          },
          {
            "kind": "sheet",
            "many": true,
            "key": "цели",
            "label": "Цели",
            "item": {
              "key": "цель",
              "label": "Цель"
            }
          },
          {
            "key": "первая",
            "label": "Первая характеристика",
            "kind": "choice",
            "from": "характеристики"
          },
          {
            "key": "вторая",
            "label": "Вторая характеристика",
            "kind": "choice",
            "from": "характеристики"
          },
          {
            "key": "точность",
            "label": "Прибавка к меткости",
            "kind": "number"
          },
          {
            "key": "урон",
            "label": "Урон сверх старшей кости",
            "kind": "number"
          }
        ],
        "steps": [
          {
            "id": "бросок",
            "type": "roll",
            "field": {
              "expr": "@действующий.[@первая.поле]"
            },
            "second": {
              "expr": "@действующий.[@вторая.поле]"
            },
            "bonus": {
              "expr": "@точность"
            }
          },
          {
            "type": "each",
            "of": "цели"
          },
          {
            "id": "проверка",
            "type": "check",
            "value": {
              "expr": "@бросок"
            },
            "versus": {
              "expr": "if(@бросок.parts.первая == @бросок.parts.вторая and @бросок.parts.первая >= 6, 0, if(@бросок.parts.первая == 1 and @бросок.parts.вторая == 1, 999, @цель.защита))"
            },
            "degrees": [
              {
                "label": "критический успех",
                "if": {
                  "expr": "@бросок.parts.первая == @бросок.parts.вторая and @бросок.parts.первая >= 6"
                }
              },
              {
                "label": "критический провал",
                "if": {
                  "expr": "@бросок.parts.первая == 1 and @бросок.parts.вторая == 1"
                }
              }
            ]
          },
          {
            "type": "branch",
            "if": {
              "expr": "@проверка.success"
            }
          },
          {
            "type": "apply",
            "target": {
              "expr": "@цель.оз"
            },
            "value": {
              "expr": "max(@бросок.parts.первая, @бросок.parts.вторая) + @урон"
            }
          },
          {
            "type": "end"
          }
        ]
      },
      "лечение": {
        "label": "Лечение",
        "description": "Возвращает очки здоровья без броска.",
        "params": [
          {
            "kind": "sheet",
            "key": "действующий",
            "label": "Кто действует"
          },
          {
            "key": "сколько",
            "label": "Сколько ОЗ",
            "kind": "number"
          }
        ],
        "steps": [
          {
            "type": "apply",
            "target": {
              "expr": "@действующий.оз"
            },
            "direction": "add",
            "value": {
              "expr": "@сколько"
            }
          }
        ]
      }
    }
  },
  "compendium": {
    "records": [
      {
