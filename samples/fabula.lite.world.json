{
  "title": "Fabula Ultima",
  "system": {
    "id": "fabula-ultima",
    "name": "Fabula Ultima",
    "tables": {
      "list": {
        "label": "Лист",
        "shape": "single",
        "owner": "sheet",
        "columns": [
          {
            "key": "lovkost",
            "label": "Ловкость",
            "kind": "number",
            "default": 8,
            "min": 6,
            "max": 12
          },
          {
            "key": "vospriyatie",
            "label": "Восприятие",
            "kind": "number",
            "default": 8,
            "min": 6,
            "max": 12
          },
          {
            "key": "sila",
            "label": "Сила",
            "kind": "number",
            "default": 8,
            "min": 6,
            "max": 12
          },
          {
            "key": "volya",
            "label": "Воля",
            "kind": "number",
            "default": 8,
            "min": 6,
            "max": 12
          },
          {
            "key": "zaschita",
            "label": "Защита",
            "kind": "number",
            "default": 10
          },
          {
            "key": "mag_zaschita",
            "label": "Магическая защита",
            "kind": "number",
            "default": 10
          },
          {
            "key": "oz_maks",
            "label": "Очки здоровья, максимум",
            "kind": "number",
            "default": 40,
            "min": 0
          },
          {
            "key": "oz",
            "label": "Очки здоровья",
            "kind": "number",
            "default": 40,
            "min": 0,
            "max": {
              "expr": "@oz_maks"
            }
          },
          {
            "key": "om_maks",
            "label": "Очки маны, максимум",
            "kind": "number",
            "default": 40,
            "min": 0
          },
          {
            "key": "om",
            "label": "Очки маны",
            "kind": "number",
            "default": 40,
            "min": 0,
            "max": {
              "expr": "@om_maks"
            }
          }
        ]
      },
      "harakteristiki": {
        "label": "Характеристики",
        "key": "word",
        "columns": [
          {
            "key": "pole",
            "label": "Поле листа",
            "kind": "text"
          }
        ],
        "rows": [
          {
            "value": "lovkost",
            "label": "Ловкость",
            "cells": {
              "pole": "lovkost"
            }
          },
          {
            "value": "vospriyatie",
            "label": "Восприятие",
            "cells": {
              "pole": "vospriyatie"
            }
          },
          {
            "value": "sila",
            "label": "Сила",
            "cells": {
              "pole": "sila"
            }
          },
          {
            "value": "volya",
            "label": "Воля",
            "cells": {
              "pole": "volya"
            }
          }
        ]
      },
      "broski": {
        "label": "Броски",
        "key": "word",
        "columns": [],
        "rows": [
          {
            "value": "proverka",
            "label": "Проверка"
          }
        ]
      },
      "oruzhie": {
        "label": "Оружие",
        "shape": "book",
        "use": "item",
        "columns": [
          {
            "key": "pervaya",
            "label": "Первая характеристика",
            "kind": "choice",
            "from": "harakteristiki"
          },
          {
            "key": "vtoraya",
            "label": "Вторая характеристика",
            "kind": "choice",
            "from": "harakteristiki"
          },
          {
            "key": "tochnost",
            "label": "Прибавка к меткости",
            "kind": "number"
          },
          {
            "key": "uron",
            "label": "Урон сверх старшей кости",
            "kind": "number"
          }
        ],
        "bindings": [
          {
            "label": "Атаковать",
            "effect": "ataka",
            "args": {
              "pervaya": {
                "expr": "@pervaya"
              },
              "vtoraya": {
                "expr": "@vtoraya"
              },
              "tochnost": {
                "expr": "@tochnost"
              },
              "uron": {
                "expr": "@uron"
              }
            }
          }
        ]
      },
      "rashodnik": {
        "label": "Расходник",
        "shape": "book",
        "use": "item",
        "columns": [
          {
            "key": "lechit",
            "label": "Сколько ОЗ возвращает",
            "kind": "number"
          }
        ],
        "bindings": [
          {
            "label": "Применить",
            "effect": "lechenie",
            "args": {
              "skolko": {
                "expr": "@lechit"
              }
            }
          }
        ]
      },
      "deystvie": {
        "label": "Действие",
        "shape": "book",
        "use": "action",
        "columns": [],
        "bindings": []
      }
    },
    "constants": {
      "para": {
        "label": "две кости характеристик",
        "kind": "die",
        "dice": [
          {
            "count": 1,
            "sides": 6,
            "name": "pervaya",
            "label": "первая"
          },
          {
            "count": 1,
            "sides": 6,
            "name": "vtoraya",
            "label": "вторая"
          }
        ]
      }
    },
    "rolls": {
      "proverka": {
        "label": "Проверка",
        "die": "para",
        "number": "sides",
        "pair": true,
        "success": {
          "expr": "(@roll.parts.pervaya == @roll.parts.vtoraya and @roll.parts.pervaya >= 6) or (not(@roll.parts.pervaya == 1 and @roll.parts.vtoraya == 1) and @rolled >= @threshold)"
        },
        "degrees": [
          {
            "label": "критический успех",
            "if": {
              "expr": "@roll.parts.pervaya == @roll.parts.vtoraya and @roll.parts.pervaya >= 6"
            }
          },
          {
            "label": "критический провал",
            "if": {
              "expr": "@roll.parts.pervaya == 1 and @roll.parts.vtoraya == 1"
            }
          }
        ],
        "fields": [
          {
            "table": "list",
            "column": "lovkost"
          },
          {
            "table": "list",
            "column": "vospriyatie"
          },
          {
            "table": "list",
            "column": "sila"
          },
          {
            "table": "list",
            "column": "volya"
          }
        ]
      }
    },
    "blocks": [
      {
        "key": "harakteristiki",
        "label": "Характеристики",
        "parts": [
          {
            "table": "list",
            "columns": [
              "lovkost",
              "vospriyatie",
              "sila",
              "volya"
            ]
          }
        ]
      },
      {
        "key": "boy",
        "label": "Бой",
        "parts": [
          {
            "table": "list",
            "columns": [
              "zaschita",
              "mag_zaschita",
              "oz",
              "oz_maks",
              "om",
              "om_maks"
            ],
            "views": {
              "oz": {
                "kind": "stepper"
              },
              "om": {
                "kind": "stepper"
              }
            }
          }
        ]
      }
    ],
    "effects": {
      "proverka": {
        "label": "Проверка",
        "description": "Две кости двух характеристик, сумма против сложности: лёгкая 7, средняя 10, трудная 13. Дубль от шестёрок и выше — успех при любой сумме, две единицы — провал при любой.",
        "params": [
          {
            "kind": "sheet",
            "key": "deystvuyuschiy",
            "label": "Кто действует"
          },
          {
            "key": "pervaya",
            "label": "Первая характеристика",
            "kind": "choice",
            "from": "harakteristiki",
            "ask": {
              "by": "actor",
              "hint": "Грани первой кости — значение этой характеристики."
            }
          },
          {
            "key": "vtoraya",
            "label": "Вторая характеристика",
            "kind": "choice",
            "from": "harakteristiki",
            "ask": {
              "by": "actor",
              "hint": "Вторая кость. Чтобы бросить одну характеристику дважды, выберите её ещё раз."
            }
          },
          {
            "key": "slozhnost",
            "label": "Сложность",
            "kind": "number",
            "ask": {
              "by": "gm",
              "hint": "Лёгкая 7, средняя 10, трудная 13."
            }
          }
        ],
        "steps": [
          {
            "id": "brosok",
            "label": "бросок",
            "type": "roll",
            "field": {
              "expr": "@deystvuyuschiy.[@pervaya.pole]"
            },
            "second": {
              "expr": "@deystvuyuschiy.[@vtoraya.pole]"
            }
          },
          {
            "id": "proverka",
            "label": "проверка",
            "type": "check",
            "value": {
              "expr": "@brosok"
            },
            "versus": {
              "expr": "if(@brosok.parts.pervaya == @brosok.parts.vtoraya and @brosok.parts.pervaya >= 6, 0, if(@brosok.parts.pervaya == 1 and @brosok.parts.vtoraya == 1, 999, @slozhnost))"
            },
            "degrees": [
              {
                "label": "критический успех",
                "if": {
                  "expr": "@brosok.parts.pervaya == @brosok.parts.vtoraya and @brosok.parts.pervaya >= 6"
                }
              },
              {
                "label": "критический провал",
                "if": {
                  "expr": "@brosok.parts.pervaya == 1 and @brosok.parts.vtoraya == 1"
                }
              }
            ]
          }
        ]
      },
      "ataka": {
        "label": "Атака",
        "description": "Проверка меткости: две кости характеристик оружия плюс его прибавка против Защиты цели. Попал — урон: старшая из двух костей плюс число оружия.",
        "params": [
          {
            "kind": "sheet",
            "key": "deystvuyuschiy",
            "label": "Кто действует"
          },
          {
            "kind": "sheet",
            "many": true,
            "key": "celi",
            "label": "Цели",
            "item": {
              "key": "cel",
              "label": "Цель"
            }
          },
          {
            "key": "pervaya",
            "label": "Первая характеристика",
            "kind": "choice",
            "from": "harakteristiki"
          },
          {
            "key": "vtoraya",
            "label": "Вторая характеристика",
            "kind": "choice",
            "from": "harakteristiki"
          },
          {
            "key": "tochnost",
            "label": "Прибавка к меткости",
            "kind": "number"
          },
          {
            "key": "uron",
            "label": "Урон сверх старшей кости",
            "kind": "number"
          }
        ],
        "steps": [
          {
            "id": "brosok",
            "label": "бросок",
            "type": "roll",
            "field": {
              "expr": "@deystvuyuschiy.[@pervaya.pole]"
            },
            "second": {
              "expr": "@deystvuyuschiy.[@vtoraya.pole]"
            },
            "bonus": {
              "expr": "@tochnost"
            }
          },
          {
            "type": "each",
            "of": "celi"
          },
          {
            "id": "proverka",
            "label": "проверка",
            "type": "check",
            "value": {
              "expr": "@brosok"
            },
            "versus": {
              "expr": "if(@brosok.parts.pervaya == @brosok.parts.vtoraya and @brosok.parts.pervaya >= 6, 0, if(@brosok.parts.pervaya == 1 and @brosok.parts.vtoraya == 1, 999, @cel.zaschita))"
            },
            "degrees": [
              {
                "label": "критический успех",
                "if": {
                  "expr": "@brosok.parts.pervaya == @brosok.parts.vtoraya and @brosok.parts.pervaya >= 6"
                }
              },
              {
                "label": "критический провал",
                "if": {
                  "expr": "@brosok.parts.pervaya == 1 and @brosok.parts.vtoraya == 1"
                }
              }
            ]
          },
          {
            "type": "branch",
            "if": {
              "expr": "@proverka.success"
            }
          },
          {
            "type": "apply",
            "target": {
              "expr": "@cel.oz"
            },
            "value": {
              "expr": "max(@brosok.parts.pervaya, @brosok.parts.vtoraya) + @uron"
            }
          },
          {
            "type": "end"
          }
        ]
      },
      "lechenie": {
        "label": "Лечение",
        "description": "Возвращает очки здоровья без броска.",
        "params": [
          {
            "kind": "sheet",
            "key": "deystvuyuschiy",
            "label": "Кто действует"
          },
          {
            "key": "skolko",
            "label": "Сколько ОЗ",
            "kind": "number"
          }
        ],
        "steps": [
          {
            "type": "apply",
            "target": {
              "expr": "@deystvuyuschiy.oz"
            },
            "direction": "add",
            "value": {
              "expr": "@skolko"
            }
          }
        ]
      }
    }
  },
  "compendium": {
    "records": [
      {
        "id": "check",
        "table": "deystvie",
        "label": "Проверка",
        "bindings": [
          {
            "label": "Бросить",
            "effect": "proverka"
