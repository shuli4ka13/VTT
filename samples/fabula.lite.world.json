        {
          "of": "remedy"
        }
      ],
      "effects": []
    },
    {
      "id": "protivnik",
      "systemId": "fabula-ultima",
      "name": "Противник",
      "values": {
        "lovkost": 8,
        "vospriyatie": 6,
        "sila": 10,
        "volya": 6,
        "zaschita": 9,
        "oz_maks": 40,
        "oz": 40
      },
      "has": [
        {
          "of": "check"
        },
        {
          "of": "weapon_example"
        }
      ],
      "effects": []
    }
  ]
}
