    "action_types": {
      "action": {
        "label": "Действие",
        "perTurn": 1
      }
    },
    "effects": {
      "risky_action": {
        "label": "Рискованное действие",
        "group": "Ремесло",
        "activation": "manual",
        "cost": "action",
        "description": "Пул к6 по рейтингу действия, берётся лучшая кость: 1–3 провал, 4–5 успех с последствием, 6 успех. Последствия крутят часы тревоги на столе. Упрощение: при рейтинге 0 бросается одна кость, а не две худших.",
        "params": [
          {
            "key": "rating",
            "label": "Рейтинг действия",
            "kind": "expr"
          }
        ],
        "steps": [
          {
            "id": "бросок",
            "type": "threshold",
            "roll": {
              "die": {
                "constant": "pool"
              },
              "check": "action_roll"
            },
            "versus": {
              "const": 4
            },
            "successWhen": "atLeast",
            "continueOn": "always",
            "degrees": {
              "table": "outcome",
              "of": "total"
            }
          },
          {
            "type": "apply",
            "target": {
              "tag": "alarm"
            },
            "direction": "set",
            "targetModifiers": false,
            "value": {
              "expr": "min(8, @стол.alarm + 1)"
            },
            "when": {
              "ref": "бросок.degree",
              "has": "успех с последствием"
            }
          },
          {
            "type": "apply",
            "target": {
              "tag": "alarm"
            },
            "direction": "set",
            "targetModifiers": false,
            "value": {
              "expr": "min(8, @стол.alarm + 2)"
            },
            "when": {
              "ref": "бросок.degree",
              "has": "провал"
            }
          }
        ]
      },
      "resist": {
        "label": "Сопротивление",
        "group": "Ремесло",
        "activation": "manual",
        "description": "Отказаться от последствия ценой стресса.",
        "steps": [
          {
            "type": "apply",
            "target": {
              "tag": "stress"
            },
            "direction": "add",
            "targetModifiers": false,
            "value": {
              "const": 2
            }
          }
        ]
      },
      "lay_low": {
        "label": "Залечь на дно",
        "group": "Банда",
        "activation": "manual",
        "description": "Тревога сбрасывается, жар банды растёт.",
        "steps": [
          {
            "type": "apply",
            "target": {
              "tag": "alarm"
            },
            "direction": "set",
            "targetModifiers": false,
            "value": {
              "const": 0
            }
          },
          {
            "type": "apply",
            "target": {
              "tag": "heat"
            },
            "direction": "set",
            "targetModifiers": false,
            "value": {
              "expr": "min(9, @стол.heat + 1)"
            }
          }
        ]
      }
    },
