        "block": "Банда",
        "columns": [],
        "bindings": []
      },
      "crit": {
        "label": "Критический успех",
        "key": "range",
        "columns": [
          {
            "key": "value",
            "label": "исход",
            "kind": "text"
          }
        ],
        "rows": [
          {
            "from": 2,
            "to": 99,
            "cells": {
              "value": "критический успех"
            }
          }
        ]
      }
    },
    "effects": {
      "risky_action": {
        "label": "Рискованное действие",
        "group": "Ремесло",
        "activation": "manual",
        "description": "Пул к6 по рейтингу действия, берётся лучшая кость: 1–3 провал, 4–5 успех с последствием, 6 успех. При рейтинге 0 — две кости, берётся худшая. Последствия крутят часы тревоги на столе. Две и более шестёрки при ненулевом рейтинге — критический успех.",
        "params": [
          {
            "key": "действующий",
            "label": "Кто действует",
            "kind": "sheet"
          },
          {
            "key": "цели",
            "label": "Цели",
            "kind": "sheet",
            "many": true
          },
          {
            "key": "rating",
            "label": "Рейтинг действия",
            "kind": "number"
          }
        ],
        "steps": [
          {
            "id": "бросок_бросок",
            "type": "roll",
            "die": "pool",
            "tags": [
              "действие",
              {
                "expr": "если(@rating == 0, \"нулевой\", \"\")"
              }
            ],
            "by": {
              "expr": "@действующий"
            },
            "against": {
              "expr": "первый(@цели)"
            }
          },
          {
            "type": "each",
            "of": "цели",
            "as": "цель"
          },
          {
            "id": "бросок",
            "type": "check",
            "value": {
              "expr": "@бросок_бросок"
            },
            "versus": {
              "expr": "4"
            },
            "continueOn": "always",
            "degrees": {
              "table": "outcome",
              "of": "total"
            }
          },
          {
            "type": "table",
            "table": "crit",
            "value": {
              "expr": "сколько(@бросок.dice.rolls, 6)"
            },
            "if": {
              "expr": "все(@rating > 0, сколько(@бросок.dice.rolls, 6) >= 2)"
            }
          },
          {
            "type": "apply",
            "target": {
              "expr": "@стол.alarm"
            },
            "direction": "set",
            "value": {
              "expr": "меньшее из(8, @стол.alarm + 1)"
            },
            "if": {
              "expr": "есть(@бросок.degree, \"успех с последствием\")"
            }
          },
          {
            "type": "apply",
            "target": {
              "expr": "@стол.alarm"
            },
            "direction": "set",
            "value": {
              "expr": "меньшее из(8, @стол.alarm + 2)"
            },
            "if": {
              "expr": "есть(@бросок.degree, \"провал\")"
            }
          }
        ]
      },
      "resist": {
        "label": "Сопротивление",
        "group": "Ремесло",
        "activation": "manual",
        "description": "Сопротивление: кости по Воле (образец ведёт только Волю; Проницательность и Мощь — по усмотрению ведущего), стресс = 6 минус лучшая кость; две шестёрки — критический успех, снимает 1 стресс. При нулевой Воле две кости, берётся худшая.",
        "steps": [
          {
            "id": "бросок_бросок",
            "type": "roll",
            "die": "resist_pool",
            "tags": [
              "сопротивление",
              {
                "expr": "если(@действующий.resolve == 0, \"нулевой\", \"\")"
              }
            ],
            "by": {
              "expr": "@действующий"
            },
            "against": {
              "expr": "первый(@цели)"
            }
          },
          {
            "type": "each",
            "of": "цели",
            "as": "цель"
          },
          {
            "id": "бросок",
            "type": "check",
            "value": {
              "expr": "@бросок_бросок"
            },
            "versus": {
              "expr": "4"
            },
            "continueOn": "always"
          },
          {
            "type": "table",
            "table": "crit",
            "value": {
              "expr": "сколько(@бросок.dice.rolls, 6)"
            },
            "if": {
              "expr": "все(@действующий.resolve > 0, сколько(@бросок.dice.rolls, 6) >= 2)"
            }
          },
          {
            "type": "apply",
            "target": {
              "expr": "@цель.stress"
            },
            "direction": "add",
            "value": {
              "expr": "если(все(@действующий.resolve > 0, сколько(@бросок.dice.rolls, 6) >= 2), -1, 6 - @бросок.natural)"
            }
          }
        ],
        "params": [
          {
            "key": "действующий",
            "label": "Кто действует",
            "kind": "sheet"
          },
          {
            "key": "цели",
            "label": "Цели",
            "kind": "sheet",
            "many": true
          }
        ]
      },
      "lay_low": {
        "label": "Залечь на дно",
        "group": "Банда",
        "activation": "manual",
        "description": "Бросок действия, которым прикрываете следы (при рейтинге 0 — две кости, худшая): жар банды снижается — 1–3 на 1, 4–5 на 2, 6 на 3, крит (две шестёрки) на 5; не ниже 0.",
        "steps": [
          {
            "id": "бросок_бросок",
            "type": "roll",
            "die": "pool",
            "tags": [
              "действие",
              {
                "expr": "если(@rating == 0, \"нулевой\", \"\")"
              }
            ],
            "by": {
              "expr": "@действующий"
            },
            "against": {
              "expr": "первый(@цели)"
            }
          },
          {
            "type": "each",
            "of": "цели",
            "as": "цель"
          },
          {
            "id": "бросок",
            "type": "check",
            "value": {
              "expr": "@бросок_бросок"
            },
            "versus": {
              "expr": "4"
            },
            "continueOn": "always",
            "degrees": {
              "table": "outcome",
              "of": "total"
            }
          },
          {
            "type": "apply",
            "target": {
              "expr": "@цель.heat"
            },
            "direction": "set",
            "value": {
              "expr": "большее из(0, @действующий.heat - если(все(@rating > 0, сколько(@бросок.dice.rolls, 6) >= 2), 5, если(@бросок.natural >= 6, 3, если(@бросок.natural >= 4, 2, 1))))"
            }
          }
        ],
        "params": [
          {
            "key": "действующий",
            "label": "Кто действует",
            "kind": "sheet"
          },
          {
            "key": "цели",
            "label": "Цели",
            "kind": "sheet",
            "many": true
          },
          {
            "key": "rating",
            "label": "Рейтинг действия",
            "kind": "number",
            "min": 0,
            "max": 4,
            "ask": {
              "by": "actor",
              "hint": "Каким действием прикрываете следы — его рейтинг."
            }
          }
        ]
      },
      "zero_rating_rule": {
        "label": "Бросок без рейтинга",
        "group": "Общие правила",
        "activation": "passive",
        "duration": {
          "kind": "permanent"
        },
        "description": "Действие с рейтингом 0: бросаются две кости и берётся худшая.",
        "modifiers": [
          {
            "tags": [
              "нулевой"
            ],
            "kind": "edit",
            "call": "roll",
            "param": "edits",
            "edit": "zero_rating",
            "if": {
              "expr": "@бросающий == @носитель"
            }
          }
        ]
      }
    },
    "grants": [
      "zero_rating_rule"
    ]
  },
