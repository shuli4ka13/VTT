    "constants": {
      "pool": {
        "label": "пул к6",
        "kind": "die",
        "dice": [
          {
            "count": {
              "expr": "max(1, @rating)"
            },
            "sides": 6
          }
        ],
        "read": "best"
      }
    },
    "roll_edits": {
      "zero_rating": {
        "label": "Без рейтинга: две кости, худшая",
        "ops": [
          {
            "op": "addDie"
          },
          {
            "op": "keepWorst",
            "n": 1
          }
        ]
      }
    },
    "tables": {
      "outcome": {
        "label": "Исход действия",
        "key": "range",
        "columns": [
          {
            "key": "value",
            "label": "исход",
            "kind": "text"
          }
        ],
        "rows": [
          {
            "from": 1,
            "to": 3,
            "cells": {
              "value": "провал"
            }
          },
          {
            "from": 4,
            "to": 5,
            "cells": {
              "value": "успех с последствием"
            }
          },
          {
            "from": 6,
            "to": 6,
            "cells": {
              "value": "успех"
            }
          }
        ]
      },
      "rolls": {
        "label": "Броски",
        "key": "word",
        "rows": [
          {
            "value": "действие"
          },
          {
            "value": "нулевой"
          }
        ]
      }
    },
    "effects": {
      "risky_action": {
        "label": "Рискованное действие",
        "group": "Ремесло",
        "activation": "manual",
        "description": "Пул к6 по рейтингу действия, берётся лучшая кость: 1–3 провал, 4–5 успех с последствием, 6 успех. При рейтинге 0 — две кости, берётся худшая. Последствия крутят часы тревоги на столе.",
        "params": [
          {
            "key": "rating",
            "label": "Рейтинг действия",
            "kind": "number"
          }
        ],
        "steps": [
          {
            "id": "бросок",
            "type": "threshold",
            "roll": {
              "die": {
                "constant": "pool"
              },
              "tags": [
                "действие",
                {
                  "expr": "@rating == 0 ? \"нулевой\" : \"\""
                }
              ]
            },
            "versus": {
              "expr": "4"
            },
            "successWhen": "atLeast",
            "continueOn": "always",
            "degrees": {
              "table": "outcome",
              "of": "total"
            }
          },
          {
            "type": "apply",
            "target": {
              "tag": "alarm"
            },
            "direction": "set",
            "targetModifiers": false,
            "value": {
              "expr": "min(8, @стол.alarm + 1)"
            },
            "when": {
              "expr": "есть(@бросок.degree, \"успех с последствием\")"
            }
          },
          {
            "type": "apply",
            "target": {
              "tag": "alarm"
            },
            "direction": "set",
            "targetModifiers": false,
            "value": {
              "expr": "min(8, @стол.alarm + 2)"
            },
            "when": {
              "expr": "есть(@бросок.degree, \"провал\")"
            }
          }
        ]
      },
      "resist": {
        "label": "Сопротивление",
        "group": "Ремесло",
        "activation": "manual",
        "description": "Отказаться от последствия ценой стресса.",
        "steps": [
          {
            "type": "apply",
            "target": {
              "tag": "stress"
            },
            "direction": "add",
            "targetModifiers": false,
            "value": {
              "expr": "2"
            }
          }
        ]
      },
      "lay_low": {
        "label": "Залечь на дно",
        "group": "Банда",
        "activation": "manual",
        "description": "Тревога на столе сбрасывается, жар банды растёт.",
        "steps": [
          {
            "type": "apply",
            "target": {
              "tag": "alarm"
            },
            "direction": "set",
            "targetModifiers": false,
            "value": {
              "expr": "0"
            }
          },
          {
            "type": "apply",
            "target": {
              "tag": "heat"
            },
            "direction": "set",
            "targetModifiers": false,
            "value": {
              "expr": "min(9, @heat + 1)"
            }
          }
        ]
      },
      "zero_rating_rule": {
        "label": "Бросок без рейтинга",
        "group": "Общие правила",
        "activation": "passive",
        "duration": {
          "kind": "permanent"
        },
        "description": "Действие с рейтингом 0: бросаются две кости и берётся худшая.",
        "modifiers": [
          {
            "kind": "roll",
            "target": "roll:any",
            "tags": [
              "нулевой"
            ],
            "edit": "zero_rating"
          }
        ]
      }
    },
    "records": {
      "move": {
        "kind": "action",
        "label": "Действие",
        "icon": "🎲",
        "group": "Приёмы",
        "hint": "Какое действие бросается — формула рейтинга по листу.",
        "props": [
