{
  "title": "13th Age",
  "system": {
    "id": "13age",
    "name": "13th Age",
    "groups": {
      "Ataka": {
        "label": "Атака"
      },
      "Boy": {
        "label": "Бой"
      },
      "Broski_i_proverki": {
        "label": "Броски и проверки"
      },
      "Chto_sluchaetsya": {
        "label": "Что случается"
      },
      "Plata": {
        "label": "Плата"
      },
      "Snaryazhenie": {
        "label": "Снаряжение"
      },
      "Priemy": {
        "label": "Приёмы"
      },
      "Obschie_pravila": {
        "label": "Общие правила"
      }
    },
    "constants": {
      "lead_die": {
        "label": "к20",
        "kind": "die",
        "dice": [
          {
            "sides": 20
          }
        ]
      }
    },
    "roll_edits": {},
    "tables": {
      "list": {
        "label": "Лист",
        "shape": "single",
        "columns": [
          {
            "key": "level",
            "label": "Уровень",
            "kind": "number",
            "default": 1,
            "min": 1,
            "max": 10
          },
          {
            "key": "ac",
            "label": "Защита от оружия (КЗ)",
            "kind": "number",
            "default": 12,
            "min": 0
          },
          {
            "key": "pd",
            "label": "Физическая защита (ФЗ)",
            "kind": "number",
            "default": 11,
            "min": 0
          },
          {
            "key": "md",
            "label": "Ментальная защита (МЗ)",
            "kind": "number",
            "default": 11,
            "min": 0
          },
          {
            "key": "hp_max",
            "label": "Максимум хитов",
            "kind": "number",
            "default": 20,
            "min": 1
          },
          {
            "key": "turn_standard",
            "label": "Стандартное",
            "kind": "number",
            "default": 1,
            "min": 0,
            "max": 1
          },
          {
            "key": "turn_move",
            "label": "Движение",
            "kind": "number",
            "default": 1,
            "min": 0,
            "max": 1
          },
          {
            "key": "turn_quick",
            "label": "Быстрое",
            "kind": "number",
            "default": 1,
            "min": 0,
            "max": 1
          }
        ]
      },
      "stol": {
        "label": "Стол",
        "shape": "single",
        "owner": "desk",
        "columns": [
          {
            "key": "escalation",
            "label": "Кость эскалации",
            "kind": "number",
            "min": 0,
            "max": 6
          }
        ]
      },
      "gruppa": {
        "label": "Группа",
        "shape": "single",
        "owner": "group",
        "columns": [
          {
            "key": "hp",
            "label": "Хиты",
            "kind": "number",
            "default": 20,
            "min": 0,
            "max": {
              "expr": "@hp_max"
            }
          },
          {
            "key": "mook_hp",
            "label": "Хиты одного в толпе",
            "kind": "number",
            "min": 0
          },
          {
            "key": "mooks_left",
            "label": "Сколько в толпе стоит",
            "expr": {
              "expr": "if(@mook_hp > 0, ceil(max(0, @hp) / @mook_hp), 1)"
            }
          }
        ]
      },
      "wield": {
        "label": "Способ атаки",
        "key": "word",
        "columns": [
          {
            "key": "attack",
            "label": "Бонус атаки",
            "kind": "number"
          },
          {
            "key": "damage",
            "label": "Прибавка к урону",
            "kind": "number"
          }
        ],
        "rows": [
          {
            "value": "blizhniy_boy_Sila",
            "label": "ближний бой — Сила",
            "cells": {
              "attack": {
                "expr": "@abilities.strength.mod"
              },
              "damage": {
                "expr": "@abilities.strength.mod"
              }
            }
          },
          {
            "value": "dalniy_boy_Lovkost",
            "label": "дальний бой — Ловкость",
            "cells": {
              "attack": {
                "expr": "@abilities.dexterity.mod"
              },
              "damage": {
                "expr": "@abilities.dexterity.mod"
              }
            }
          }
        ]
      },
      "rolls": {
        "label": "Броски",
        "key": "word",
        "rows": [
          {
            "value": "ataka",
            "label": "атака"
          }
        ]
      },
      "abilities": {
        "label": "Характеристики",
        "key": "word",
        "columns": [
          {
            "key": "score",
            "label": "Значение",
            "kind": "number",
            "min": 3,
            "max": 24,
            "title": "{label}",
            "default": 10
          },
          {
            "key": "mod",
            "label": "Модификатор",
            "kind": "number",
            "expr": {
              "expr": "floor((@row.score - 10) / 2)"
            },
            "title": "Модификатор: {label}"
          }
        ],
        "rows": [
          {
            "value": "strength",
            "label": "Сила"
          },
          {
            "value": "constitution",
            "label": "Телосложение"
          },
          {
            "value": "dexterity",
            "label": "Ловкость"
          },
          {
            "value": "intelligence",
            "label": "Интеллект"
          },
          {
            "value": "wisdom",
            "label": "Мудрость"
          },
          {
            "value": "charisma",
            "label": "Харизма"
          }
        ],
        "owner": "sheet"
      },
      "weapon": {
        "label": "Оружие",
        "icon": "⚔",
        "hint": "Кость оружия и способ атаки свои у каждого.",
        "shape": "book",
        "use": "item",
        "block": "Snaryazhenie",
        "columns": [
          {
            "key": "weapon_die",
            "label": "Кость оружия",
            "kind": "dice"
          },
          {
            "key": "wield",
            "label": "Способ атаки",
            "kind": "choice",
            "from": "wield"
          }
        ],
        "bindings": [
          {
            "label": "Удар",
            "effect": "hero_attack",
            "args": {
              "attack_with": {
                "expr": "@wield.attack"
              },
              "damage_with": {
                "expr": "@wield.damage"
              },
              "weapon_die": {
                "expr": "@weapon_die"
              }
            }
          }
        ]
      },
      "monster_move": {
        "label": "Приём монстра",
        "icon": "👹",
        "hint": "Бонус атаки и урон вписаны числами.",
        "shape": "book",
        "use": "action",
        "block": "Priemy",
        "columns": [
          {
            "key": "to_hit",
            "label": "Бонус атаки",
            "kind": "number"
          },
          {
            "key": "hit_damage",
            "label": "Урон при попадании",
            "kind": "number"
          }
        ],
        "bindings": [
          {
            "label": "Атаковать",
            "effect": "monster_attack",
            "args": {
              "to_hit": {
                "expr": "@to_hit"
              },
              "hit_damage": {
                "expr": "@hit_damage"
              }
            }
          }
        ]
      },
      "attack_outcomes": {
        "label": "Исход атаки",
        "key": "word",
        "columns": [
          {
            "key": "dice_mul",
            "label": "множитель костей урона",
            "kind": "number"
          },
          {
            "key": "hit",
            "label": "попал",
            "kind": "boolean"
          }
        ],
        "rows": [
          {
            "value": "promah",
            "label": "промах",
            "cells": {
              "dice_mul": 0,
              "hit": false
            }
          },
          {
            "value": "popadanie",
            "label": "попадание",
            "cells": {
              "dice_mul": 1,
              "hit": true
            }
          },
          {
            "value": "krit",
            "label": "крит",
            "cells": {
              "dice_mul": 2,
              "hit": true
            }
          }
        ]
      }
    },
    "initiative": {
      "die": "lead_die",
      "bonus": {
        "expr": "@abilities.dexterity.mod + @level"
      }
    },
    "effects": {
      "damage": {
        "label": "Урон",
        "group": "Chto_sluchaetsya",
        "params": [
          {
            "key": "list",
            "label": "Лист",
            "kind": "sheet",
            "role": "target"
          },
          {
            "key": "source",
            "label": "Источник",
            "kind": "sheet",
            "optional": true,
            "role": "actor"
          },
          {
            "key": "amount",
            "label": "Сколько урона",
            "kind": "number",
            "role": "amount"
          }
        ],
        "steps": [
          {
            "type": "apply",
            "target": {
              "expr": "@list.hp"
            },
            "value": {
              "expr": "@amount"
            }
          }
        ]
      },
      "hero_attack": {
        "label": "Атака героя",
        "group": "Ataka",
        "description": "к20 + модификатор + уровень + кость эскалации против КЗ. Попал — кость оружия за каждый уровень, на 20 вдвое. Промах — урон, равный уровню.",
        "params": [
          {
            "key": "deystvuyuschiy",
            "label": "Кто действует",
            "kind": "sheet"
          },
          {
            "key": "aims",
            "label": "Цели",
            "kind": "sheet",
            "many": true,
            "item": {
              "key": "aim",
              "label": "Цель"
            }
          },
          {
            "key": "weapon_die",
            "label": "Кость оружия",
            "kind": "dice"
          },
          {
            "key": "attack_with",
            "label": "Бонус атаки",
            "kind": "number"
          },
          {
            "key": "damage_with",
            "label": "Прибавка к урону",
            "kind": "number"
          }
        ],
        "steps": [
          {
            "type": "each",
            "of": "aims"
          },
          {
            "id": "brosok",
            "label": "бросок",
            "type": "emit",
            "effect": "attack_roll",
            "args": {
              "bonus_2": {
                "expr": "@attack_with + @deystvuyuschiy.level + @desk.escalation"
              },
              "who": {
                "expr": "@deystvuyuschiy"
              },
              "protiv": {
                "expr": "@aim"
              }
            }
          },
          {
            "type": "branch",
            "if": {
              "expr": "@brosok.ishod.hit"
            }
          },
          {
            "id": "uron",
            "label": "урон",
            "type": "roll",
            "die": {
              "expr": "@weapon_die"
            },
            "times": {
              "expr": "@deystvuyuschiy.level * @brosok.ishod.dice_mul"
            },
            "bonus": {
              "expr": "@damage_with"
            }
          },
          {
            "type": "emit",
            "effect": "damage",
            "args": {
              "amount": {
                "expr": "@uron.total"
              },
              "list": {
                "expr": "@aim"
              },
              "source": {
                "expr": "@deystvuyuschiy"
              }
            }
          },
          {
            "type": "orElse"
          },
          {
            "type": "emit",
            "effect": "damage",
            "args": {
              "amount": {
                "expr": "@deystvuyuschiy.level"
              },
              "list": {
                "expr": "@aim"
              },
              "source": {
                "expr": "@deystvuyuschiy"
              }
            }
          },
          {
            "type": "end"
          }
        ],
        "cost": [
          {
            "type": "emit",
            "effect": "cost_standard",
            "args": {
              "list": {
                "expr": "@deystvuyuschiy"
              },
              "source": {
                "expr": "@deystvuyuschiy"
              }
            }
          }
        ],
        "tags": [
          "ataka"
        ]
      },
      "monster_attack": {
        "label": "Атака монстра",
        "group": "Ataka",
        "description": "Монстры бьют фиксированным уроном и кость эскалации не получают.",
        "params": [
          {
            "key": "deystvuyuschiy",
            "label": "Кто действует",
            "kind": "sheet"
          },
          {
            "key": "aims",
            "label": "Цели",
            "kind": "sheet",
            "many": true,
            "item": {
              "key": "aim",
              "label": "Цель"
            }
          },
          {
            "key": "to_hit",
            "label": "Бонус атаки",
            "kind": "number"
          },
          {
            "key": "hit_damage",
            "label": "Урон при попадании",
            "kind": "number"
          }
        ],
        "steps": [
          {
            "type": "each",
            "of": "aims"
          },
          {
            "id": "brosok",
            "label": "бросок",
            "type": "emit",
            "effect": "attack_roll",
            "args": {
              "bonus_2": {
                "expr": "@to_hit"
              },
              "who": {
                "expr": "@deystvuyuschiy"
              },
              "protiv": {
                "expr": "@aim"
              }
            }
          },
          {
            "type": "branch",
            "if": {
              "expr": "@brosok.ishod.hit"
            }
          },
          {
            "type": "emit",
            "effect": "damage",
            "args": {
              "amount": {
                "expr": "@hit_damage"
              },
              "list": {
                "expr": "@aim"
              },
              "source": {
                "expr": "@deystvuyuschiy"
              }
            }
          },
          {
            "type": "end"
          }
        ],
        "cost": [
          {
            "type": "emit",
            "effect": "cost_standard",
            "args": {
              "list": {
                "expr": "@deystvuyuschiy"
              },
              "source": {
                "expr": "@deystvuyuschiy"
              }
            }
          }
        ],
        "tags": [
          "ataka"
        ]
      },
      "cost_standard": {
        "label": "Стоимость: стандартное",
        "group": "Plata",
        "description": "Списывается только в бою. Не хватило — действие не состоялось.",
        "params": [
          {
            "key": "list",
            "label": "Лист",
            "kind": "sheet",
            "role": "actor"
          },
          {
            "key": "source",
            "label": "Источник",
            "kind": "sheet",
            "optional": true,
            "role": "actor"
          }
        ],
        "steps": [
          {
            "type": "branch",
            "if": {
              "expr": "@desk.combat"
            }
          },
          {
            "type": "branch",
            "if": {
              "expr": "@list.turn_standard < 1"
            }
          },
          {
            "type": "stop",
            "note": {
              "expr": "\"стандартное действие на этом ходу уже потрачено\""
            }
          },
          {
            "type": "end"
          },
          {
            "type": "apply",
            "target": {
              "expr": "@list.turn_standard"
            },
            "value": {
              "expr": "1"
            }
          },
          {
            "type": "end"
          }
        ]
      },
      "battle_start": {
        "label": "Начало боя",
        "group": "Obschie_pravila",
        "description": "Бой пошёл: траты хода считаются, у всех полный запас.",
        "activation": "passive",
        "duration": {
          "kind": "permanent"
        },
        "on": [
          {
            "on": "moment:combat-start",
            "steps": [
              {
                "type": "apply",
                "target": {
                  "expr": "@holder.turn_standard"
                },
                "direction": "set",
                "value": {
                  "expr": "1"
                }
              },
              {
                "type": "apply",
                "target": {
                  "expr": "@holder.turn_move"
                },
                "direction": "set",
                "value": {
                  "expr": "1"
                }
              },
              {
                "type": "apply",
                "target": {
                  "expr": "@holder.turn_quick"
                },
                "direction": "set",
                "value": {
                  "expr": "1"
                }
              }
            ]
          }
        ]
      },
      "turn_refresh": {
        "label": "Начало хода",
        "group": "Obschie_pravila",
        "description": "Траты хода — снова полные.",
        "activation": "passive",
        "duration": {
          "kind": "permanent"
        },
        "on": [
          {
            "on": "moment:turn-start",
            "if": {
              "expr": "@mover == @holder"
            },
            "steps": [
              {
                "type": "apply",
                "target": {
                  "expr": "@holder.turn_standard"
                },
                "direction": "set",
                "value": {
                  "expr": "1"
                }
              },
              {
                "type": "apply",
                "target": {
                  "expr": "@holder.turn_move"
                },
                "direction": "set",
                "value": {
                  "expr": "1"
                }
              },
              {
                "type": "apply",
                "target": {
                  "expr": "@holder.turn_quick"
                },
                "direction": "set",
                "value": {
                  "expr": "1"
                }
              }
            ]
          }
        ]
      },
      "escalation_round": {
        "label": "Эскалация раунда",
        "group": "Obschie_pravila",
        "description": "В начале каждого раунда, кроме первого, кость эскалации растёт на единицу (не выше 6); в первом раунде — 0. Висит на столе — срабатывает раз за раунд.",
        "activation": "passive",
        "duration": {
          "kind": "permanent"
        },
        "on": [
          {
            "on": "moment:round-start",
            "steps": [
              {
                "type": "apply",
                "target": {
                  "expr": "@desk.escalation"
                },
                "direction": "set",
                "value": {
                  "expr": "if(@moment.round > 1, min(6, @desk.escalation + 1), 0)"
                }
              }
            ]
          }
        ]
      },
      "attack_roll": {
        "label": "Бросок атаки",
        "group": "Broski_i_proverki",
        "description": "Бросок к20 + бонус против защиты (КД) цели; 20 на кости — крит.",
        "params": [
          {
            "key": "who",
            "label": "Кто бросает",
            "kind": "sheet",
            "role": "actor"
          },
          {
            "key": "protiv",
            "label": "Против кого",
            "kind": "sheet",
            "role": "target"
          },
          {
            "key": "bonus_2",
            "label": "Бонус атаки",
            "kind": "number",
            "default": 0
          }
        ],
        "returns": [
          {
            "key": "ishod",
            "label": "исход",
            "kind": "choice",
            "from": "attack_outcomes",
            "expr": {
              "expr": "if(not @proverka.success, \"promah\", if(@proverka.natural >= 20, \"krit\", \"popadanie\"))"
            }
          },
          {
            "key": "na_kostyah",
            "label": "на костях",
            "kind": "number",
            "expr": {
              "expr": "@proverka.natural"
            }
          }
        ],
        "steps": [
          {
            "id": "brosok",
            "label": "бросок",
            "type": "roll",
            "die": "lead_die",
            "bonus": {
              "expr": "@bonus_2"
            },
            "tags": [
              "ataka"
            ],
            "by": {
              "expr": "@who"
            }
          },
          {
            "id": "proverka",
            "label": "проверка",
            "type": "check",
            "value": {
              "expr": "@brosok"
            },
            "versus": {
              "expr": "@protiv.ac"
            }
          }
        ]
      }
    },
    "grants": [
      "battle_start",
      "turn_refresh"
    ],
    "sheets": {
      "personazh": {
        "label": "Персонаж",
        "icon": "🧙",
        "hint": "Лист героя."
      },
      "protivnik": {
        "label": "Противник",
        "icon": "👹",
        "hint": "Лист противника."
      },
      "desk": {
        "label": "Стол",
        "icon": "🎲",
        "hint": "Общий стол комнаты: кость эскалации и бой.",
        "grants": [
          "escalation_round"
        ]
      }
    },
    "tags": {
      "ataka": {
        "label": "Атака",
        "inputs": [
          {
            "key": "deystvuyuschiy",
            "kind": "sheet"
          },
          {
            "key": "aims",
            "kind": "sheet",
            "many": true
          }
        ],
        "each": "aim",
        "outputs": [
          "brosok"
        ]
      }
    },
    "blocks": [
      {
        "key": "Harakteristiki",
        "label": "Характеристики",
        "parts": [
          {
            "table": "list",
            "columns": [
              "level"
            ],
            "views": {
              "level": {
                "kind": "stepper"
              }
            }
          },
          {
            "table": "abilities",
            "columns": [
              "score"
            ]
          }
        ]
      },
      {
        "key": "Modifikatory",
        "label": "Модификаторы",
        "parts": [
          {
            "table": "abilities",
            "columns": [
              "mod"
            ],
            "views": {
              "mod": {
                "kind": "signed"
              }
            }
          }
        ]
      },
      {
        "key": "Zaschita",
        "label": "Защита",
        "parts": [
          {
            "table": "list",
            "columns": [
              "ac",
              "pd",
              "md"
            ]
          }
        ]
      },
