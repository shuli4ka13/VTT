    "effects": {
      "risky_action": {
        "label": "Рискованное действие",
        "group": "Remeslo",
        "description": "Пул к6 по рейтингу действия, берётся лучшая кость: 1–3 провал, 4–5 успех с последствием, 6 успех. При рейтинге 0 — две кости, берётся худшая. Последствия крутят часы тревоги на столе. Две и более шестёрки при ненулевом рейтинге — критический успех.",
        "params": [
          {
            "key": "deystvuyuschiy",
            "label": "Кто действует",
            "kind": "sheet"
          },
          {
            "key": "aims",
            "label": "Цели",
            "kind": "sheet",
            "many": true,
            "item": {
              "key": "aim",
              "label": "Цель"
            }
          },
          {
            "key": "rating",
            "label": "Рейтинг действия",
            "kind": "field"
          }
        ],
        "steps": [
          {
            "id": "brosok_brosok",
            "label": "бросок бросок",
            "type": "roll",
            "field": {
              "expr": "@rating"
            }
          },
          {
            "type": "each",
            "of": "aims"
          },
          {
            "id": "brosok",
            "label": "бросок",
            "type": "check",
            "value": {
              "expr": "@brosok_brosok"
            },
            "versus": {
              "expr": "4"
            },
            "degrees": {
              "table": "outcome"
            }
          },
          {
            "type": "branch",
            "if": {
              "expr": "@rating > 0 and count(@brosok.dice.rolls, 6) >= 2"
            }
          },
          {
            "type": "table",
            "table": "crit",
            "value": {
              "expr": "count(@brosok.dice.rolls, 6)"
            }
          },
          {
            "type": "end"
          },
          {
            "type": "branch",
            "if": {
              "expr": "@brosok.degree == \"успех с последствием\""
            }
          },
          {
            "type": "apply",
            "target": {
              "expr": "@desk.alarm"
            },
            "direction": "set",
            "value": {
              "expr": "min(8, @desk.alarm + 1)"
            }
          },
          {
            "type": "orElse",
            "if": {
              "expr": "@brosok.degree == \"провал\""
            }
          },
          {
            "type": "apply",
            "target": {
              "expr": "@desk.alarm"
            },
            "direction": "set",
            "value": {
              "expr": "min(8, @desk.alarm + 2)"
            }
          },
          {
            "type": "end"
          }
        ]
      },
      "zero_rating_rule": {
        "label": "Бросок без рейтинга",
        "group": "Obschie_pravila",
        "activation": "passive",
        "duration": {
          "kind": "permanent"
        },
        "description": "Действие с рейтингом 0: бросаются две кости и берётся худшая.",
        "modifiers": [
          {
            "tags": [
              "deystvie"
            ],
            "kind": "edit",
            "call": "roll",
            "param": "tags",
            "value": {
              "expr": "\"nulevoy\""
            },
            "if": {
              "expr": "@roller == @holder and @number == 0"
            }
          },
          {
            "tags": [
              "deystvie"
            ],
            "kind": "edit",
            "call": "roll",
            "param": "count",
            "op": "add",
            "value": {
              "expr": "1"
            },
            "if": {
              "expr": "@roller == @holder and @number == 0"
            }
          },
          {
            "tags": [
              "nulevoy"
            ],
            "kind": "edit",
            "call": "roll",
            "param": "edits",
            "edit": "zero_rating",
            "if": {
              "expr": "@roller == @holder"
            }
          }
        ]
      }
    },
    "grants": [
      "zero_rating_rule"
