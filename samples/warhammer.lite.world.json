    "rolls": {
      "проверка": {
        "label": "Проверка",
        "die": "кость",
        "number": "under",
        "success": {
          "expr": "@rolled <= 5 or (@rolled <= 95 and @rolled <= @threshold)"
        },
        "margin": {
          "expr": "if(@rolled <= 5 or @rolled >= 96, 0, floor(@threshold / 10) - floor(@rolled / 10))"
        },
        "degrees": [
          {
            "label": "Ошеломительный успех",
            "if": {
              "expr": "@success and @margin >= 5"
            }
          },
          {
            "label": "Впечатляющий успех",
            "if": {
              "expr": "@success and @margin >= 3"
            }
          },
          {
            "label": "Успех",
            "if": {
              "expr": "@success and @margin >= 1"
            }
          },
          {
            "label": "Успех на грани",
            "if": {
              "expr": "@success"
            }
          },
          {
            "label": "Ошеломительный провал",
            "if": {
              "expr": "@margin <= -5"
            }
          },
          {
            "label": "Впечатляющий провал",
            "if": {
              "expr": "@margin <= -3"
            }
          },
          {
            "label": "Провал",
            "if": {
              "expr": "@margin <= -1"
            }
          },
          {
            "label": "Провал на грани",
            "if": {
              "expr": "not(@success)"
            }
          }
        ],
