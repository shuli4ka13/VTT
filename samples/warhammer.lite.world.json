    "effects": {
      "выстрел": {
        "label": "Выстрел",
        "description": "Обычная проверка Стрельбы. Попал — урон оружия плюс степени успеха, минус броня места попадания; остаток — раны. Место — по цифре единиц броска.",
        "params": [
          {
            "kind": "sheet",
            "key": "действующий",
            "label": "Кто действует"
          },
          {
            "kind": "sheet",
            "many": true,
            "key": "цели",
            "label": "Цели",
            "item": {
              "key": "цель",
              "label": "Цель"
            }
          },
          {
            "key": "урон",
            "label": "Урон оружия",
            "kind": "number"
          }
        ],
        "steps": [
          {
            "type": "each",
            "of": "цели"
          },
          {
            "id": "бросок",
            "type": "roll",
            "field": {
              "expr": "@действующий.навыки.стрельба.итог"
            }
          },
          {
            "type": "branch",
            "if": {
              "expr": "@бросок.success"
            }
          },
          {
            "id": "место",
            "type": "table",
            "table": "места",
            "value": {
              "expr": "@бросок.natural - floor(@бросок.natural / 10) * 10"
            }
          },
          {
            "id": "прошло",
            "type": "roll",
            "fixed": {
              "expr": "max(0, @урон + @бросок.margin - @цель.броня.[@место].бонус_брони)"
            }
          },
          {
            "type": "apply",
            "target": {
              "expr": "@цель.раны"
            },
            "direction": "add",
            "value": {
              "expr": "@прошло"
            }
          },
          {
            "type": "end"
          }
        ]
      },
      "удар": {
        "label": "Удар",
        "description": "Встречная проверка: Ближний бой бьющего против Ближнего боя или Рефлексов защитника. Побеждает больший запас степеней; при равных — больший навык; при полном равенстве решает ведущий. Урон — урон оружия, бонус Силы и разница степеней, минус броня места; защитник урона не наносит.",
        "params": [
          {
            "kind": "sheet",
            "key": "действующий",
            "label": "Кто действует"
          },
          {
            "kind": "sheet",
            "many": true,
            "key": "цели",
            "label": "Цели",
            "item": {
              "key": "цель",
              "label": "Цель"
            }
          },
          {
            "key": "урон",
            "label": "Урон оружия",
            "kind": "number"
          },
          {
            "key": "чем",
            "label": "Чем защищается",
            "kind": "choice",
            "from": "чем_защищается",
            "ask": {
              "by": "gm",
              "hint": "Ближний бой или Рефлексы (Уклонение) — выбирает ведущий."
            }
          }
        ],
        "steps": [
          {
            "type": "each",
            "of": "цели"
          },
          {
            "id": "удар",
            "type": "roll",
            "field": {
              "expr": "@действующий.навыки.рукопашный_бой.итог"
            }
          },
          {
            "id": "защита",
            "type": "roll",
            "field": {
              "expr": "@цель.навыки.[@чем.навык].итог"
            }
          },
          {
            "type": "branch",
            "if": {
              "expr": "@удар.margin == @защита.margin and @действующий.навыки.рукопашный_бой.итог == @цель.навыки.[@чем.навык].итог"
            }
          },
          {
            "id": "решение",
            "type": "ask",
            "label": "Ничья. Кто победил?",
            "yes": "Бьющий",
            "no": "Защитник"
          },
          {
            "type": "branch",
            "if": {
              "expr": "not(@решение)"
            }
          },
          {
            "type": "stop"
          },
          {
            "type": "end"
          },
          {
            "type": "end"
          },
          {
            "id": "победа",
            "type": "roll",
            "fixed": {
              "expr": "if(@удар.margin > @защита.margin or (@удар.margin == @защита.margin and @действующий.навыки.рукопашный_бой.итог >= @цель.навыки.[@чем.навык].итог), 1, 0)"
            }
          },
          {
            "type": "branch",
            "if": {
              "expr": "@победа == 1"
            }
          },
          {
            "id": "место",
            "type": "table",
            "table": "места",
            "value": {
              "expr": "@удар.natural - floor(@удар.natural / 10) * 10"
            }
          },
          {
            "id": "прошло",
            "type": "roll",
            "fixed": {
              "expr": "max(0, @урон + @действующий.характеристики.сила.бонус_характеристики + @удар.margin - @защита.margin - @цель.броня.[@место].бонус_брони)"
            }
          },
          {
            "type": "apply",
            "target": {
              "expr": "@цель.раны"
            },
            "direction": "add",
            "value": {
              "expr": "@прошло"
            }
          },
          {
            "type": "end"
          }
        ]
      },
      "первая_помощь": {
        "label": "Первая помощь",
        "description": "Проверка Медицины: вне боя Простая (+20), в бою Обычная (+0). Нужно хотя бы одно развитие навыка. Успех снимает раны: степени успеха плюс бонус Интеллекта лечащего.",
        "params": [
          {
            "kind": "sheet",
            "key": "действующий",
            "label": "Кто действует"
          },
          {
            "kind": "sheet",
            "many": true,
            "key": "цели",
            "label": "Цели",
            "item": {
              "key": "цель",
              "label": "Цель"
            }
          },
          {
            "key": "сложность",
            "label": "Поправка сложности",
            "kind": "number",
            "ask": {
              "by": "actor",
              "hint": "Вне боя +20, в бою 0."
            }
          }
        ],
        "steps": [
          {
            "type": "branch",
            "if": {
              "expr": "@действующий.навыки.медицина.развитие < 1"
            }
          },
          {
            "type": "stop",
            "note": {
              "expr": "\"Нужно хотя бы одно развитие Медицины\""
            }
          },
          {
            "type": "end"
          },
          {
            "type": "each",
            "of": "цели"
          },
          {
            "id": "бросок",
            "type": "roll",
            "field": {
              "expr": "@действующий.навыки.медицина.итог"
            },
            "shift": {
              "expr": "@сложность"
            }
          },
          {
            "type": "branch",
            "if": {
              "expr": "@бросок.success"
            }
          },
          {
            "type": "apply",
            "target": {
              "expr": "@цель.раны"
            },
            "value": {
              "expr": "@бросок.margin + @действующий.характеристики.интеллект.бонус_характеристики"
            }
          },
          {
            "type": "end"
          }
        ]
      }
    },
