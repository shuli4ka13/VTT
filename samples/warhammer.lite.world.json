    "effects": {
      "vystrel": {
        "label": "Выстрел",
        "description": "Обычная проверка Стрельбы. Попал — урон оружия плюс степени успеха, минус броня места попадания; остаток — раны. Место — по цифре единиц броска.",
        "params": [
          {
            "kind": "sheet",
            "key": "deystvuyuschiy",
            "label": "Кто действует"
          },
          {
            "kind": "sheet",
            "many": true,
            "key": "aims",
            "label": "Цели",
            "item": {
              "key": "aim",
              "label": "Цель"
            }
          },
          {
            "key": "damage",
            "label": "Урон оружия",
            "kind": "number"
          }
        ],
        "steps": [
          {
            "type": "each",
            "of": "aims"
          },
          {
            "id": "brosok",
            "label": "бросок",
            "type": "roll",
            "field": {
              "expr": "@deystvuyuschiy.navyki.strelba.total"
            }
          },
          {
            "type": "branch",
            "if": {
              "expr": "@brosok.success"
            }
          },
          {
            "id": "mesto",
            "label": "место",
            "type": "table",
            "table": "mesta",
            "value": {
              "expr": "@brosok.natural - floor(@brosok.natural / 10) * 10"
            }
          },
          {
            "id": "proshlo",
            "label": "прошло",
            "type": "roll",
            "fixed": {
              "expr": "max(0, @damage + @brosok.margin - @aim.armor.[@mesto].bonus_broni)"
            }
          },
          {
            "type": "apply",
            "target": {
              "expr": "@aim.rany"
            },
            "direction": "add",
            "value": {
              "expr": "@proshlo"
            }
          },
          {
            "type": "end"
          }
        ]
      },
      "udar": {
        "label": "Удар",
        "description": "Встречная проверка: Ближний бой бьющего против Ближнего боя или Рефлексов защитника. Побеждает больший запас степеней; при равных — больший навык; при полном равенстве решает ведущий. Урон — урон оружия, бонус Силы и разница степеней, минус броня места; защитник урона не наносит.",
        "params": [
          {
            "kind": "sheet",
            "key": "deystvuyuschiy",
            "label": "Кто действует"
          },
          {
            "kind": "sheet",
            "many": true,
            "key": "aims",
            "label": "Цели",
            "item": {
              "key": "aim",
              "label": "Цель"
            }
          },
          {
            "key": "damage",
            "label": "Урон оружия",
            "kind": "number"
          },
          {
            "key": "chem",
            "label": "Чем защищается",
            "kind": "choice",
            "from": "chem_zaschischaetsya",
            "ask": {
              "by": "gm",
              "hint": "Ближний бой или Рефлексы (Уклонение) — выбирает ведущий."
            }
          }
        ],
        "steps": [
          {
            "type": "each",
            "of": "aims"
          },
          {
            "id": "udar",
            "label": "удар",
            "type": "roll",
            "field": {
              "expr": "@deystvuyuschiy.navyki.rukopashnyy_boy.total"
            }
          },
          {
            "id": "defense",
            "label": "защита",
            "type": "roll",
            "field": {
              "expr": "@aim.navyki.[@chem.skill].total"
            }
          },
          {
            "type": "branch",
            "if": {
              "expr": "@udar.margin == @defense.margin and @deystvuyuschiy.navyki.rukopashnyy_boy.total == @aim.navyki.[@chem.skill].total"
            }
          },
          {
            "id": "reshenie",
            "type": "ask",
            "label": "Ничья. Кто победил?",
            "yes": "Бьющий",
            "no": "Защитник"
          },
          {
            "type": "branch",
            "if": {
              "expr": "not(@reshenie)"
            }
          },
          {
            "type": "stop"
          },
          {
            "type": "end"
          },
          {
            "type": "end"
          },
          {
            "id": "pobeda",
            "label": "победа",
            "type": "roll",
            "fixed": {
              "expr": "if(@udar.margin > @defense.margin or (@udar.margin == @defense.margin and @deystvuyuschiy.navyki.rukopashnyy_boy.total >= @aim.navyki.[@chem.skill].total), 1, 0)"
            }
          },
          {
            "type": "branch",
            "if": {
              "expr": "@pobeda == 1"
            }
          },
          {
            "id": "mesto",
            "label": "место",
            "type": "table",
            "table": "mesta",
            "value": {
              "expr": "@udar.natural - floor(@udar.natural / 10) * 10"
            }
          },
          {
            "id": "proshlo",
            "label": "прошло",
            "type": "roll",
            "fixed": {
              "expr": "max(0, @damage + @deystvuyuschiy.harakteristiki.strength.bonus_harakteristiki + @udar.margin - @defense.margin - @aim.armor.[@mesto].bonus_broni)"
            }
          },
          {
            "type": "apply",
            "target": {
              "expr": "@aim.rany"
            },
            "direction": "add",
            "value": {
              "expr": "@proshlo"
            }
          },
          {
            "type": "end"
          }
        ]
      },
      "pervaya_pomosch": {
        "label": "Первая помощь",
        "description": "Проверка Медицины: вне боя Простая (+20), в бою Обычная (+0). Нужно хотя бы одно развитие навыка. Успех снимает раны: степени успеха плюс бонус Интеллекта лечащего.",
        "params": [
          {
            "kind": "sheet",
            "key": "deystvuyuschiy",
            "label": "Кто действует"
          },
          {
            "kind": "sheet",
            "many": true,
            "key": "aims",
            "label": "Цели",
            "item": {
              "key": "aim",
              "label": "Цель"
            }
          },
          {
            "key": "slozhnost",
            "label": "Поправка сложности",
            "kind": "number",
            "ask": {
              "by": "actor",
              "hint": "Вне боя +20, в бою 0."
            }
          }
        ],
        "steps": [
          {
            "type": "branch",
            "if": {
              "expr": "@deystvuyuschiy.navyki.medicina.razvitie < 1"
            }
          },
          {
            "type": "stop",
            "note": {
              "expr": "\"Нужно хотя бы одно развитие Медицины\""
            }
          },
          {
            "type": "end"
          },
          {
            "type": "each",
            "of": "aims"
          },
          {
            "id": "brosok",
            "label": "бросок",
            "type": "roll",
            "field": {
              "expr": "@deystvuyuschiy.navyki.medicina.total"
            },
            "shift": {
              "expr": "@slozhnost"
            }
          },
          {
            "type": "branch",
            "if": {
              "expr": "@brosok.success"
            }
          },
          {
            "type": "apply",
            "target": {
              "expr": "@aim.rany"
            },
            "value": {
              "expr": "@brosok.margin + @deystvuyuschiy.harakteristiki.intelligence.bonus_harakteristiki"
            }
          },
          {
            "type": "end"
          }
        ]
      }
    },
