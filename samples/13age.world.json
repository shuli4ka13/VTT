            "kind": "number"
          },
          {
            "key": "damage",
            "label": "Прибавка к урону",
            "kind": "number"
          }
        ],
        "rows": [
          {
            "value": "ближний бой — Сила",
            "cells": {
              "attack": {
                "expr": "@abilities.сила.mod"
              },
              "damage": {
                "expr": "@abilities.сила.mod"
              }
            }
          },
          {
            "value": "дальний бой — Ловкость",
            "cells": {
              "attack": {
                "expr": "@abilities.ловкость.mod"
              },
              "damage": {
                "expr": "@abilities.ловкость.mod"
              }
            }
          }
        ]
      },
      "rolls": {
        "label": "Броски",
        "key": "word",
        "rows": [
          {
            "value": "атака"
          }
        ]
      },
      "abilities": {
        "label": "Характеристики",
        "key": "word",
        "columns": [
          {
            "key": "score",
            "label": "Значение",
            "kind": "number",
            "min": 3,
            "max": 24,
            "title": "{label}",
            "block": "Характеристики",
            "default": 10
          },
          {
            "key": "mod",
            "label": "Модификатор",
            "kind": "number",
            "expr": "округлить вниз((@строка.score - 10) / 2)",
            "title": "Модификатор: {label}",
            "block": "Модификаторы"
          }
        ],
        "rows": [
          {
            "value": "сила",
            "label": "Сила"
          },
          {
            "value": "телосложение",
            "label": "Телосложение"
          },
          {
            "value": "ловкость",
            "label": "Ловкость"
          },
          {
            "value": "интеллект",
            "label": "Интеллект"
          },
          {
            "value": "мудрость",
            "label": "Мудрость"
          },
          {
            "value": "харизма",
            "label": "Харизма"
          }
        ],
        "owner": "sheet"
      },
      "weapon": {
        "label": "Оружие",
        "icon": "⚔",
        "hint": "Кость оружия и способ атаки свои у каждого.",
        "shape": "book",
        "use": "item",
        "block": "Снаряжение",
        "columns": [
          {
            "key": "weapon_die",
            "label": "Кость оружия",
            "kind": "dice"
          },
          {
            "key": "wield",
            "label": "Способ атаки",
            "kind": "choice",
            "from": "wield"
          }
        ],
        "bindings": [
          {
            "label": "Удар",
            "effect": "hero_attack",
            "args": {
              "attack_with": {
                "expr": "таблица(\"wield\", @wield, \"attack\")"
              },
              "damage_with": {
                "expr": "таблица(\"wield\", @wield, \"damage\")"
              }
            }
          }
        ]
      },
      "monster_move": {
        "label": "Приём монстра",
        "icon": "👹",
        "hint": "Бонус атаки и урон вписаны числами.",
        "shape": "book",
        "use": "action",
        "block": "Приёмы",
        "columns": [
          {
            "key": "to_hit",
            "label": "Бонус атаки",
            "kind": "number"
          },
          {
            "key": "hit_damage",
            "label": "Урон при попадании",
            "kind": "number"
          }
        ],
        "bindings": [
          {
            "label": "Атаковать",
            "effect": "monster_attack"
          }
        ]
      },
      "battle": {
        "label": "Ход боя",
        "icon": "⏱",
        "hint": "Ведущий двигает кость эскалации.",
        "shape": "book",
        "use": "action",
        "block": "Приёмы",
        "columns": [],
        "bindings": []
      }
    },
    "initiative": {
      "die": {
        "constant": "lead_die"
      },
      "bonus": {
        "expr": "@abilities.ловкость.mod + @level"
      }
    },
    "effects": {
      "damage": {
        "label": "Урон",
        "group": "Вызываемые",
        "params": [
          {
            "key": "amount",
            "label": "Сколько урона",
            "kind": "number",
            "role": "amount"
          }
        ],
        "steps": [
          {
            "type": "apply",
            "target": {
              "tag": "hp"
            },
            "direction": "subtract",
            "targetModifiers": false,
            "value": {
              "expr": "@event.amount"
            }
          }
        ]
      },
      "hero_attack": {
        "label": "Атака героя",
        "group": "Атака",
        "activation": "manual",
        "description": "к20 + модификатор + уровень + кость эскалации против КЗ. Попал — кость оружия за каждый уровень, на 20 вдвое. Промах — урон, равный уровню.",
        "params": [
          {
            "key": "weapon_die",
            "label": "Кость оружия",
            "kind": "dice"
          },
          {
            "key": "attack_with",
            "label": "Бонус атаки",
            "kind": "number"
          },
          {
            "key": "damage_with",
            "label": "Прибавка к урону",
            "kind": "number"
          }
        ],
        "steps": [
          {
            "type": "each"
          },
          {
            "id": "hit",
            "type": "threshold",
            "roll": {
              "die": {
                "constant": "lead_die"
              },
              "bonus": {
                "expr": "@attack_with + @отправитель.level + @стол.escalation"
              },
              "tags": [
                "атака"
              ]
            },
            "versus": {
              "expr": "@получатель.ac"
            },
            "successWhen": "atLeast",
            "continueOn": "always"
          },
          {
            "id": "dmg",
            "type": "amount",
            "source": "item",
            "fixed": {
              "expr": "кинуть(@weapon_die, @отправитель.level * если(@hit.natural >= 20, 2, 1)) + @damage_with"
            },
            "when": {
              "expr": "@hit.success"
            }
          },
          {
            "type": "emit",
            "event": "damage",
            "args": {
              "amount": {
                "expr": "@dmg"
              }
            },
            "when": {
              "expr": "@hit.success"
            }
          },
          {
            "type": "emit",
            "event": "damage",
            "args": {
              "amount": {
                "expr": "@отправитель.level"
              }
            },
            "when": {
              "expr": "не(@hit.success)"
            }
          }
        ],
        "cost": [
          {
            "type": "emit",
            "event": "cost_standard",
            "strict": true
          }
        ]
      },
      "monster_attack": {
        "label": "Атака монстра",
        "group": "Атака",
        "activation": "manual",
        "description": "Монстры бьют фиксированным уроном и кость эскалации не получают.",
        "params": [
          {
            "key": "to_hit",
            "label": "Бонус атаки",
            "kind": "number"
          },
          {
            "key": "hit_damage",
            "label": "Урон при попадании",
            "kind": "number"
          }
        ],
        "steps": [
          {
            "type": "each"
          },
          {
            "id": "hit",
            "type": "threshold",
            "roll": {
              "die": {
                "constant": "lead_die"
              },
              "bonus": {
                "expr": "@to_hit"
              },
              "tags": [
                "атака"
              ]
            },
            "versus": {
              "expr": "@получатель.ac"
            },
            "successWhen": "atLeast"
          },
          {
            "type": "emit",
            "event": "damage",
            "args": {
              "amount": {
                "expr": "@hit_damage"
              }
            }
          }
        ],
        "cost": [
          {
            "type": "emit",
            "event": "cost_standard",
            "strict": true
          }
        ]
      },
      "new_round": {
        "label": "Новый раунд",
        "group": "Бой",
        "activation": "manual",
        "description": "Кость эскалации растёт на единицу, но не выше 6. Только если ведущий ведёт раунды без часов: при ходах по инициативе кость растёт сама в начале раунда — не жмите вместе.",
        "steps": [
          {
            "type": "apply",
            "target": {
              "tag": "escalation"
            },
            "direction": "set",
            "targetModifiers": false,
            "value": {
              "expr": "меньшее из(6, @стол.escalation + 1)"
            }
          }
        ]
      },
      "end_battle": {
        "label": "Конец боя",
        "group": "Бой",
        "activation": "manual",
        "description": "Кость эскалации сбрасывается.",
        "steps": [
          {
            "type": "apply",
            "target": {
              "tag": "escalation"
            },
            "direction": "set",
            "targetModifiers": false,
            "value": {
              "expr": "0"
            }
          }
        ]
      },
      "battle_start": {
        "label": "Начало боя",
        "group": "Общие правила",
        "description": "Бой пошёл: траты хода считаются, у всех полный запас.",
        "activation": "passive",
        "duration": {
          "kind": "permanent"
        },
        "params": [],
        "on": [
          {
            "on": "moment:combat-start",
            "steps": [
              {
                "type": "apply",
                "target": {
                  "tag": "battle"
                },
                "direction": "set",
                "value": {
                  "expr": "1"
                },
                "targetModifiers": false
              },
              {
                "type": "apply",
                "target": {
                  "tag": "turn_standard"
                },
                "direction": "set",
                "value": {
                  "expr": "1"
                },
                "targetModifiers": false
              },
              {
                "type": "apply",
                "target": {
                  "tag": "turn_move"
                },
                "direction": "set",
                "value": {
                  "expr": "1"
                },
                "targetModifiers": false
              },
              {
                "type": "apply",
                "target": {
                  "tag": "turn_quick"
                },
                "direction": "set",
                "value": {
                  "expr": "1"
                },
                "targetModifiers": false
              }
            ]
          }
        ]
      },
      "battle_end": {
        "label": "Конец боя",
        "group": "Общие правила",
        "description": "Вне боя действия не считаются.",
        "activation": "passive",
        "duration": {
          "kind": "permanent"
        },
        "params": [],
        "on": [
          {
            "on": "moment:combat-end",
            "steps": [
              {
                "type": "apply",
                "target": {
                  "tag": "battle"
                },
                "direction": "set",
                "value": {
                  "expr": "0"
                },
                "targetModifiers": false
              }
            ]
          }
        ]
      },
      "turn_refresh": {
        "label": "Начало хода",
        "group": "Общие правила",
        "description": "Траты хода — снова полные.",
        "activation": "passive",
        "duration": {
          "kind": "permanent"
        },
        "params": [],
        "on": [
          {
            "on": "moment:turn-start",
            "steps": [
              {
                "type": "apply",
                "target": {
                  "tag": "turn_standard"
                },
                "direction": "set",
                "value": {
                  "expr": "1"
                },
                "targetModifiers": false
              },
              {
                "type": "apply",
                "target": {
                  "tag": "turn_move"
                },
                "direction": "set",
                "value": {
                  "expr": "1"
                },
                "targetModifiers": false
              },
              {
                "type": "apply",
                "target": {
                  "tag": "turn_quick"
                },
                "direction": "set",
                "value": {
                  "expr": "1"
                },
                "targetModifiers": false
              }
            ]
          }
        ]
      },
      "cost_standard": {
        "label": "Стоимость: стандартное",
        "group": "Стоимость",
        "activation": "manual",
        "description": "Списывается только в бою. Не хватило — действие не состоялось.",
        "params": [],
        "steps": [
          {
            "type": "compare",
            "value": {
              "expr": "@получатель.turn_standard"
            },
            "versus": {
              "expr": "1"
            },
            "breakIf": "less",
            "note": "стандартное действие на этом ходу уже потрачено",
            "when": {
              "expr": "@стол.battle >= 1"
            }
          },
          {
            "type": "apply",
            "target": {
              "tag": "turn_standard"
            },
            "direction": "subtract",
            "value": {
              "expr": "1"
            },
            "targetModifiers": false,
            "when": {
              "expr": "@стол.battle >= 1"
            }
          }
        ]
      },
      "escalation_round": {
        "label": "Эскалация раунда",
        "group": "Общие правила",
        "description": "В начале каждого раунда, кроме первого, кость эскалации растёт на единицу (не выше 6); в первом раунде — 0. Висит на столе — срабатывает раз за раунд.",
        "activation": "passive",
        "duration": {
          "kind": "permanent"
        },
        "params": [],
        "on": [
          {
            "on": "moment:round-start",
            "steps": [
              {
                "type": "apply",
                "target": {
                  "tag": "escalation"
                },
                "direction": "set",
                "value": {
                  "expr": "если(@moment.round > 1, меньшее из(6, @стол.escalation + 1), 0)"
                },
                "targetModifiers": false
              }
            ]
          }
        ]
      }
    },
    "grants": [
