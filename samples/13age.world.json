    "effects": {
      "damage": {
        "label": "Урон",
        "group": "Вызываемые",
        "params": [
          {
            "key": "amount",
            "label": "Сколько урона",
            "kind": "number",
            "role": "amount"
          }
        ],
        "steps": [
          {
            "type": "apply",
            "target": {
              "tag": "hp"
            },
            "direction": "subtract",
            "targetModifiers": false,
            "value": {
              "expr": "@event.amount"
            }
          }
        ]
      },
      "hero_attack": {
        "label": "Атака героя",
        "group": "Атака",
        "activation": "manual",
        "description": "к20 + модификатор + уровень + кость эскалации против КЗ. Попал — кость оружия за каждый уровень, на 20 вдвое. Промах — урон, равный уровню.",
        "params": [
          {
            "key": "weapon_die",
            "label": "Кость оружия",
            "kind": "dice"
          },
          {
            "key": "attack_with",
            "label": "Бонус атаки",
            "kind": "number"
          },
          {
            "key": "damage_with",
            "label": "Прибавка к урону",
            "kind": "number"
          }
        ],
        "steps": [
          {
            "id": "hit",
            "type": "threshold",
            "roll": {
              "die": {
                "constant": "lead_die"
              },
              "bonus": {
                "expr": "@attack_with + @отправитель.level + @стол.escalation"
              },
              "tags": [
                "атака"
              ]
            },
            "versus": {
              "expr": "@получатель.ac"
            },
            "successWhen": "atLeast",
            "continueOn": "always"
          },
          {
            "id": "dmg",
            "type": "amount",
            "source": "item",
            "fixed": {
              "expr": "кинуть(@weapon_die, @отправитель.level * (@hit.natural >= 20 ? 2 : 1)) + @damage_with"
            },
            "when": {
              "expr": "@hit.success"
            }
          },
          {
            "type": "emit",
            "event": "damage",
            "args": {
              "amount": {
                "expr": "@dmg"
              }
            },
            "when": {
              "expr": "@hit.success"
            }
          },
          {
            "type": "emit",
            "event": "damage",
            "args": {
              "amount": {
                "expr": "@отправитель.level"
              }
            },
            "when": {
              "expr": "не(@hit.success)"
            }
          }
        ],
        "self": [
          {
            "type": "emit",
            "event": "cost_standard",
            "strict": true
          }
        ]
      },
      "monster_attack": {
        "label": "Атака монстра",
        "group": "Атака",
        "activation": "manual",
        "description": "Монстры бьют фиксированным уроном и кость эскалации не получают.",
