{
  "id": "uchebnaya",
  "name": "Учебная система",
  "langs": [
    "ru",
    "en"
  ],
  "effects": {
    "udar": {
      "label": "Удар",
      "params": [
        {
          "key": "deystvuyuschiy",
          "label": "Кто действует",
          "kind": "sheet",
          "i18n": {
            "en": {
              "label": "Who acts"
            }
          }
        },
        {
          "key": "celi",
          "label": "Цели",
          "kind": "sheet",
          "many": true,
          "item": {
            "key": "cel",
            "label": "Цель",
            "i18n": {
              "en": {
                "label": "Target"
              }
            }
          },
          "i18n": {
            "en": {
              "label": "Targets"
            }
          }
        }
      ],
      "steps": [
        {
          "type": "each",
          "of": "celi"
        },
        {
          "id": "brosok",
          "label": "бросок",
          "type": "roll",
          "die": "kost",
          "by": {
            "expr": "@deystvuyuschiy"
          },
          "i18n": {
            "en": {
              "label": "roll"
            }
          }
        },
        {
          "id": "proverka",
          "label": "проверка",
          "type": "check",
          "value": {
            "expr": "@brosok"
          },
          "versus": {
            "expr": "@cel.klass_broni"
          },
          "i18n": {
            "en": {
              "label": "check"
            }
          }
        },
        {
          "type": "branch",
          "if": {
            "expr": "@proverka.success"
          }
        },
        {
          "type": "apply",
          "target": {
            "expr": "@cel.hity"
          },
          "value": {
            "expr": "5"
          }
        },
        {
          "type": "end"
        }
      ],
      "i18n": {
        "en": {
          "label": "Strike"
        }
      }
    }
  },
  "grants": [
    "udar"
  ],
  "constants": {
    "kost": {
      "label": "Кость проверки",
      "kind": "die",
      "dice": [
        {
          "sides": 20
        }
      ],
      "i18n": {
        "en": {
          "label": "Check die"
        }
      }
    }
  },
  "tables": {
    "list": {
      "label": "Лист",
      "shape": "single",
      "columns": [
        {
          "key": "hity",
          "label": "Хиты",
          "kind": "number",
          "default": 10,
          "min": 0,
          "i18n": {
            "en": {
              "label": "Hit points"
            }
          }
        },
        {
          "key": "klass_broni",
          "label": "Класс брони",
          "kind": "number",
          "default": 12,
          "i18n": {
            "en": {
              "label": "Armor class"
            }
          }
        }
      ],
      "i18n": {
        "en": {
          "label": "Sheet"
        }
      }
    }
  },
  "blocks": [
    {
      "key": "novyy_blok",
      "label": "Бой",
      "parts": [
        {
          "table": "list"
        }
      ],
      "i18n": {
        "en": {
          "label": "Combat"
        }
      }
    }
  ]
}
