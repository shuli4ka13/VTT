{
  "extends": "../../tsconfig.base.json",
  "include": ["src"],
  "references": [
    { "path": "../../packages/schema" },
    { "path": "../../packages/engine" }
  ],
  "compilerOptions": {
    "module": "ESNext",
    "types": ["node"],

    "experimentalDecorators": true,
    "useDefineForClassFields": false,

    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": true,
    "rewriteRelativeImportExtensions": true
  }
}
