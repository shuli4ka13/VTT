{
  "extends": "../../tsconfig.base.json",
  "include": ["src", "test"],
  "compilerOptions": {
    "module": "ESNext",
    "types": ["node"],
    // NestJS строит внедрение зависимостей на декораторах. Метаданные типов
    // (emitDecoratorMetadata) esbuild не умеет, поэтому все зависимости
    // объявляются явными токенами через @Inject — заодно и тесты подменяют
    // их без магии.
    "experimentalDecorators": true,
    "useDefineForClassFields": false
  }
}
