{
  "name": "@vtt/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b ../../packages/engine && tsx watch src/main.ts",
    "start": "node dist/main.js",
    "test": "tsc -b ../../packages/engine && vitest run",
    "typecheck": "tsc -b ../../packages/engine && tsc --noEmit",
    "seed": "tsc -b ../../packages/engine && tsx src/seed-run.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/platform-ws": "^11.2.1",
    "@nestjs/websockets": "^11.2.1",
    "@vtt/engine": "*",
    "@vtt/schema": "*",
    "drizzle-orm": "^0.45.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.1",
    "@types/node": "^24.13.3",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "supertest": "^7.2.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
