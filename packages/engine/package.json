{
  "name": "@vtt/engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./samples": {
      "types": "./dist/samples.d.ts",
      "default": "./dist/samples.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "typecheck": "tsc -b ../schema && tsc --noEmit"
  },
  "devDependencies": {
    "@vtt/schema": "*",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "sideEffects": false
}
