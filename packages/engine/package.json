{
  "name": "@vtt/engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./formula": {
      "types": "./dist/formula/index.d.ts",
      "default": "./dist/formula/index.js"
    },
    "./model/*": {
      "types": "./dist/model/*.d.ts",
      "default": "./dist/model/*.js"
    },
    "./engine/*": {
      "types": "./dist/engine/*.d.ts",
      "default": "./dist/engine/*.js"
    },
    "./events/*": {
      "types": "./dist/events/*.d.ts",
      "default": "./dist/events/*.js"
    },
    "./words/*": {
      "types": "./dist/words/*.d.ts",
      "default": "./dist/words/*.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "typecheck": "tsc -b ../schema && tsc --noEmit"
  },
  "devDependencies": {
    "@vtt/schema": "*",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
